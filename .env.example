# Owner phone number in international digits, without +
BOT_OWNER=YOUR_COUNTRY_CODE_AND_NUMBER
# Image shown with .alive. Must be a direct, public image URL (not a Facebook/Instagram
# page link — those don't work). Easiest options: upload the photo to your GitHub repo and
# use the "raw.githubusercontent.com" link, or host it on any public image host.
ALIVE_IMG=
OWNER_NAME=Tharun Prabashwara
OWNER_GITHUB=https://github.com/tharunprabashwara642-dot
# Set your real website/social links; blank links are hidden in .alive/.menu
OWNER_WEBSITE=https://tharun-liard.vercel.app/
OWNER_WHATSAPP=https://wa.me/94707915458
OWNER_FACEBOOK=https://www.facebook.com/share/1F7ZFB6jsy/?mibextid=wwXIfr
OWNER_INSTAGRAM=
BOT_NAME=Dobby-Md
PREFIX=.
STORAGE_DIR=/data
BOT_MODE=public
ANTIDELETE_ENABLED=true
# One-time greeting sent to a new private chat the first time it messages the bot.
# Leave blank to use the built-in default (uses BOT_NAME/OWNER_NAME automatically).
GREETING_MSG=
# WhatsApp's practical max is around 2 GB; this is capped below 1.9 GB to leave headroom.
MAX_DOWNLOAD_BYTES=1900000000
DOWNLOAD_TIMEOUT_MS=600000
# Multiple accounts: each account must be paired separately; persistent volume required
# BOT_ACCOUNTS=[{"id":"main","ownerNumber":"YOUR_NUMBER","sessionId":""},{"id":"work","ownerNumber":"YOUR_NUMBER","sessionId":""}]
# Optional Supabase audit log integration (never put keys in source control)
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_AUDIT_TABLE=bot_audit_events
# Gemini (used by .ai and .vision). Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.5-flash-lite
AI_VISION_MODEL=gemini-3.5-flash-lite
# Scheduled messages use Sri Lanka time (UTC+5:30 = 330 minutes)
TZ_OFFSET_MIN=330
# YTDLP_BIN=yt-dlp

# Optional tuning for video sending (defaults shown)
# WA_VIDEO_LIMIT_BYTES=62914560
# FFMPEG_TIMEOUT_MS=600000
